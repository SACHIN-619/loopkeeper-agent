# =============================================================================
# LOOPKEEPER ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BACKEND & AGENT ENGINE CONFIGURATION (Python Backend / Cloud Run)
# -----------------------------------------------------------------------------
# Backend Storage Engine: 'json' for deterministic local sandbox, 'firestore' for production
LOOPKEEPER_BACKEND=json

# Google Gemini API Key (Required for ADK Agent reasoning & Gemini Vision PDF extraction)
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Google Cloud Project ID (Required when LOOPKEEPER_BACKEND=firestore)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Email Integration Mode: 'gmail' for live OAuth Gmail monitoring/sending, or leave unset for sandbox simulation
# LOOPKEEPER_EMAIL_MODE=gmail


# -----------------------------------------------------------------------------
# 2. FRONTEND FIREBASE AUTHENTICATION (React App / Vite)
# -----------------------------------------------------------------------------
# Required for user Authentication (Google Sign-In & Email/Password Sign-Up)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Backend API Endpoint URL (Required when frontend connects to deployed Cloud Run backend)
# Example: https://loopkeeper-agent-xyz-uc.a.run.app
VITE_CLOUD_RUN_URL=


# -----------------------------------------------------------------------------
# 3. MULTI-CHANNEL WEBHOOK CONFIGURATION (Optional for SMS / WhatsApp)
# -----------------------------------------------------------------------------
# WhatsApp Webhook Verification Token (For Meta Business API handshake)
WHATSAPP_VERIFY_TOKEN=loopkeeper

# Twilio SMS Configuration (Optional for live SMS sending)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
